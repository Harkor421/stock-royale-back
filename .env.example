# Free key from https://finnhub.io/register
#
# ⚠ The free plan allows exactly ONE live WebSocket per key. Running a second
#   process with the same key (local dev while the deploy is up, two services,
#   two browsers of yours don't count — only backends) knocks the first one off
#   and gets the key rate-limited with HTTP 429. Use a second key for local dev,
#   or stop the deploy while you develop, or just run `npm run sim`.
FINNHUB_API_KEY=

# Port (Railway sets this automatically)
PORT=8080

# Round length in ms (default 5 minutes). Rounds align to the wall clock.
ROUND_MS=300000

# Set to 1 to run the synthetic feed instead of the live tape (dev only).
SIM=0
