# Free key from https://finnhub.io/register
#
# ⚠ The free plan allows exactly ONE live WebSocket per key. Running a second
#   process with the same key (local dev while the deploy is up, two services,
#   two browsers of yours don't count — only backends) knocks the first one off
#   and gets the key rate-limited with HTTP 429. Use a second key for local dev,
#   or stop the deploy while you develop, or just run `npm run sim`.
FINNHUB_API_KEY=

# Port (Railway sets this automatically)
PORT=8080

# Round length in ms (default 5 minutes). Rounds align to the wall clock.
ROUND_MS=300000

# Set to 1 to run the synthetic feed instead of the live tape (dev only).
SIM=0

# ===== The prize: airdrop the winning stock to the memecoin's holders =====
# Off unless AIRDROP=1, and DRY_RUN stays on until you deliberately turn it off.
AIRDROP=0
DRY_RUN=true

# Robinhood Chain (Arbitrum Orbit L2, EVM, gas in ETH)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# The PRO host. The public explorer (robinhoodchain.blockscout.com) is behind a
# Cloudflare challenge and answers servers 403 with an HTML page — which reads
# downstream as "this token has no holders". See README > Holder detection.
BLOCKSCOUT_URL=https://api.blockscout.com/4663
BLOCKSCOUT_API_KEY=

# With no key, holders are rebuilt from Transfer logs over the RPC instead.
# Set the token's first block to make that cheap and incremental.
CHAIN_FALLBACK=true
TOKEN_START_BLOCK=
CHAIN_MAX_CALLS=400

# Pool / bonding-curve exclusion. A contract holding this much of supply is
# infrastructure, not a holder. POOL_CANDIDATES is checked on-chain regardless.
POOL_MIN_PCT=0.5
POOL_CANDIDATES=0x8366a39cc670b4001a1121b8f6a443a643e40951,0x52d571fe77027298e06e52fc4434e1507f819268

# Re-read balances from the chain before splitting the airdrop
VERIFY_ONCHAIN=true
VERIFY_MAX=400
# Refuse to pay over a crawl that saw less than this % of supply
MIN_SUPPLY_COVERAGE=40
EXPLORER_URL=https://robinhoodchain.blockscout.com

# The memecoin whose holders receive the winning stock
TOKEN=

# Pot wallet: holds ETH to buy with, and pays the gas. NEVER commit a real key.
DISTRIBUTOR_PRIVATE_KEY=

WETH=0x0bd7d308f8e1639fab988df18a8011f41eacad73
SWAP_ROUTER=0xCb0615a1478838DeA20E57447309be97f45DcA0f
BUY_PCT=80
BUY_SLIPPAGE_PCT=20
LEAVE_ETH=0.003

# Eligibility
MIN_ELIGIBLE_PCT=0.1
MAX_HOLDER_PCT=50
EXCLUDE_CONTRACTS=true
EXCLUDE_ADDRESSES=

# Dev only: fake holders so the airdrop panel can be reviewed with no token yet
DEMO_HOLDERS=0
